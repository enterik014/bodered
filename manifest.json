{
  "manifest_version": 2,
  "name": "Bodered",
  "version": "1.0",

  "description": "Boder you",

  "icons": {
    "64": "icons/icon.svg"
  },

  "browser_action": {
    "default_popup": "timers/choose_time.html",
    "default_icon": "icons/popup.png"
  },
  "permissions": ["tabs", "activeTab", "storage", "notifications"],
  
  "background": {
    "scripts": ["main.js"]
  }
}
